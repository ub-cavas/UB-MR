// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CartesianConvert

struct LidarData
{
    float angle;
    float distance;
};

RWStructuredBuffer<LidarData> lidarBuffer;

[numthreads(8,8,1)]
void CartesianConvert (uint3 id : SV_DispatchThreadID)
{
    lidarBuffer[id.x].angle = lidarBuffer[id.x].angle + 1;
}
