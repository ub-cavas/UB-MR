// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel LiDAR_Modifier


Texture3D<float> _SDFTexture; // mesh-to-sdf texture
SamplerState sampler_SDFTexture;
float4x4 _WorldToSDF;        // Transforms from world space to SDF texture space (0-1)
float4x4 _SDFToWorld;        // Transform SDF texture space (0-1) to world space

float3 origin;
// Raymarching parameters
float _MaxDistance;          // Maximum distance to march
float _HitThreshold;         // Distance threshold to consider a hit (e.g., 0.001)
int _MaxIterations;          // Maximum iterations (e.g., 128)
float _StepScale;           // Scale factor for stepping (0.5 to 1.0, lower = more accurate but slower)

struct UnityLaserScan
{
    float3 position;
    uint hasIntersection;
};

RWStructuredBuffer<UnityLaserScan> laserScanBuffer;

float SampleSDF(float3 worldPosition, Texture3D<float> sdf)
{
    // Transform world position to SDF texture coordinates (0-1)
    float4 sdfPos = mul(_WorldToSDF, float4(worldPosition, 1.0));
    // Return a very large distance if outside SDF bounds
    if (any(sdfPos.xyz < 0.0) || any(sdfPos.xyz > 1.0))
    {
        return 1000000.0;
    }
    // Sample the SDF texture
    return sdf.SampleLevel(sampler_SDFTexture, sdfPos.xyz, 0).r;
}

float3 Raymarch(float3 rayDirection, float3 initialPosition)
{
    float3 currentPosition = origin;
    float totalDistance = 0.0;
    for (int i = 0; i < _MaxIterations; i++)
    {
        // Sample the SDF at current position
        float distance = SampleSDF(currentPosition, _SDFTexture);
        
        // Check if we hit the surface
        if (distance < _HitThreshold)
        {
            return currentPosition; // Hit point found
        }
        
        // Check if we've exceeded maximum distance
        if (totalDistance >= _MaxDistance)
        {
            break; // No intersection within max distance
        }
        
        // Step along the ray
        float stepSize = distance * _StepScale;
        currentPosition += rayDirection * stepSize;
        totalDistance += stepSize;
    }
    
    // No intersection found - return initial position far away
    return initialPosition;
}

[numthreads(64,1,1)]
void LiDAR_Modifier (uint3 id : SV_DispatchThreadID)
{
    UnityLaserScan scan = laserScanBuffer[id.x];
    /*float3 hitPosition = Raymarch(scan.direction, scan.position);
    float distanceToHit = length(hitPosition - origin);
    if (distanceToHit < scan.range)
    {
        // Valid hit found
        scan.position = hitPosition;
        scan.range = distanceToHit;
        scan.hasIntersection = 1;
    }*/
    // Write back to buffer
    laserScanBuffer[id.x] = scan;
}


