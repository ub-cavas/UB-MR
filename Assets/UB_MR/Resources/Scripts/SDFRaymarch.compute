#pragma kernel SDFRaymarch
#define THREADS 128

StructuredBuffer<float4> _Points; // in: current best point along the ray (LOCAL to object),
RWStructuredBuffer<float4> _ModifiedPoints; //out: hit position (world.xyz), hit (w)

float4x4 _WorldToSDFSpace;
float4x4 _SDFToWorldSpace;
Texture3D<float> _SDF;
SamplerState sampler_SDF;

// Units are in SDF space
float _Margin;
float _MaxDistance;
int   _MaxIterations;
float _HitThreshold;

// NEW: object transform inputs
float3   _RayOriginWorld;  
float4x4 _LocalToWorldRS;   // rotation & scale only (no translation)
float4x4 _WorldToLocalRS;   // inverse (rotation + scale)

float3 WorldToTexPoint(float3 worldPos) { return mul(_WorldToSDFSpace, float4(worldPos, 1.0)).xyz; }
float3 WorldToTexDir  (float3 worldDir) { return mul(_WorldToSDFSpace, float4(worldDir, 0.0)).xyz; }
float  SampleSDF(float3 texPos)         { return _SDF.SampleLevel(sampler_SDF, texPos, 0).r - _Margin; }

bool RayBoxUnit(float3 rayOrigin, float3 rayDirection, out float tEnter, out float tExit)
{
    float3 inv = 1.0 / rayDirection;
    float3 t0  = (0.0 - rayOrigin) * inv;
    float3 t1  = (1.0 - rayOrigin) * inv;
    float3 tmin = min(t0, t1);
    float3 tmax = max(t0, t1);
    tEnter = max(max(tmin.x, tmin.y), tmin.z);
    tExit  = min(min(tmax.x, tmax.y), tmax.z);
    return (tExit >= max(tEnter, 0.0));
}

[numthreads(THREADS,1,1)]
void SDFRaymarch (uint3 id : SV_DispatchThreadID)
{
    uint count, stride;
    _Points.GetDimensions(count, stride);
    if (id.x >= count) return;

    // Direction in OBJECT-LOCAL space
    float4 currentPoint = _Points[id.x];
    float3 localDir = currentPoint.xyz;
    if (all(abs(localDir) < 1e-6)) { _ModifiedPoints[id.x] = currentPoint; return; }

    // Convert to WORLD direction using rotation+scale only (no translation)
    float3 worldDir = mul(_LocalToWorldRS, float4(localDir, 0.0)).xyz;

    // Transform ray to TEXTURE (SDF) space
    float3 texRayOrigin = WorldToTexPoint(_RayOriginWorld);
    float3 texRayDir    = WorldToTexDir(worldDir);
    texRayDir = normalize(texRayDir); // stable AABB intersection & t stepping

    // Clip to unit cube [0,1]^3
    float tEnter, tExit;
    if (!RayBoxUnit(texRayOrigin, texRayDir, tEnter, tExit)) { _ModifiedPoints[id.x] = currentPoint; return; }
    float step = max(tEnter, 0.0);
    float currentDistance = length(localDir);
    
    // Raymarch
    [loop]
    for (int i = 0; i < _MaxIterations && step <= tExit; ++i)
    {
        float3 texPoint = texRayOrigin + step * texRayDir;
        float dist = SampleSDF(texPoint);
        if (dist < _HitThreshold)
        {
            float3 worldHit = mul(_SDFToWorldSpace, float4(texPoint, 1.0)).xyz;
            float3 localHit = mul(_WorldToLocalRS, float4(worldHit - _RayOriginWorld, 0.0)).xyz;
            float hitDistance = length(localHit);
            if (hitDistance <= _MaxDistance && hitDistance < currentDistance)
            {
                _ModifiedPoints[id.x] = float4(localHit, 1.0);
            }
            else
            {
                _ModifiedPoints[id.x] = currentPoint;
            }
            return;
        }
        if (dist >= 1.0)
        {
            dist = 0.05;
        }
        step += dist; // distances are already in SDF-space units
    }

    // no hit
    _ModifiedPoints[id.x] = currentPoint;
}
