<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Shared DDS configuration for a rosbag on the host and the UB-MR container.
  UB-MR uses Docker host networking.  A loopback peer provides discovery even
  when the host has no multicast-capable interface available to CycloneDDS.
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <Discovery>
      <Peers>
        <Peer Address="127.0.0.1" />
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
